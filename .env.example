# Database
DATABASE_URL="postgresql://macbookpro2018@localhost:5432/ai_code_auditor?schema=public"

# Server
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

# LLM providers — set the ones you plan to use.
# Which provider is used per-request is chosen by "provider" in the API call,
# falling back to DEFAULT_LLM_PROVIDER.
DEFAULT_LLM_PROVIDER="anthropic"
# Used when a call to the default provider fails (out of credits, bad key,
# rate limit, outage), so reviews keep running. Leave empty for no backup.
LLM_FALLBACK_PROVIDER=""

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

GEMINI_API_KEY=""
# Flash models are the cost-effective choice for reviews; Pro models cost several times more.
# New API keys can't use Gemini 2.5 any more.
GEMINI_MODEL="gemini-3.8-flash"
# How much Gemini may think before it answers (billed as output): "low" (default) or "high".
# GEMINI_THINKING_LEVEL="low"
# For Gemini 2.5 models only: a thinking budget in tokens instead (0 turns it off on Flash).
# GEMINI_THINKING_BUDGET="1024"

# OpenAI-compatible providers — cheaper alternatives, same request shape.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"

GLM_API_KEY=""
GLM_MODEL="glm-4.5-flash"

# DashScope keys are region-specific — this uses the international endpoint,
# so the key must be issued for that region, not the mainland-China one.
QWEN_API_KEY=""
QWEN_MODEL="qwen-plus"

KIMI_API_KEY=""
KIMI_MODEL="kimi-k2.5"

XAI_API_KEY=""
XAI_MODEL="grok-3-fast"

MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

MINIMAX_API_KEY=""
MINIMAX_MODEL="MiniMax-M2.5"

# Optional — a stronger/pricier model used only to double-check findings
# that come back high-severity but low-confidence (see PipelineService).
# Leave unset to skip escalation entirely (default, cheapest).
# ANTHROPIC_ESCALATION_MODEL="claude-opus-4-5"
# OPENAI_ESCALATION_MODEL="gpt-5"
# GEMINI_ESCALATION_MODEL="gemini-3.1-pro-preview"
# DEEPSEEK_ESCALATION_MODEL="deepseek-v4-pro"
# GLM_ESCALATION_MODEL="glm-5.2"
# QWEN_ESCALATION_MODEL="qwen-max"
# KIMI_ESCALATION_MODEL="kimi-k2.6"
# XAI_ESCALATION_MODEL="grok-4-0709"
# MISTRAL_ESCALATION_MODEL="mistral-large-latest"
# MINIMAX_ESCALATION_MODEL="MiniMax-M3"

# Repo scan limits — each file that Stage 1 flags as risky is one LLM
# request; files Stage 1 clears cost nothing. Keep these conservative.
MAX_SCAN_FILES=15
MAX_FILE_SIZE_BYTES=100000

# Auth — generate your own: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET="changeme"
JWT_EXPIRES_IN="7d"

# Encrypts GitHub/GitLab tokens at rest (AES-256-GCM) — must decode (base64)
# to exactly 32 bytes. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="changeme"

# Optional — only needed for self-hosted GitLab instances.
# GITLAB_BASE_URL="https://gitlab.example.com/api/v4"

# A new account with this email becomes a super_admin only when it signs
# in with Google or GitHub (which verify the address). Password signups
# never get the role. Or promote an existing account directly:
#   npm run admin:promote -- you@example.com
SUPER_ADMIN_EMAIL="you@example.com"

# This server's own publicly-reachable base URL — used to build the OAuth
# redirect_uri, which must match EXACTLY what's registered in the GitHub/
# GitLab OAuth app settings (including scheme and no trailing slash).
BACKEND_ORIGIN="http://localhost:4000"

# "Login with GitHub" — create an OAuth app at
# https://github.com/settings/developers ("New OAuth App"). Set its
# "Authorization callback URL" to {BACKEND_ORIGIN}/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# "Login with GitLab" — create an application at
# https://gitlab.com/-/user_settings/applications (or your self-hosted
# instance's equivalent). Set its redirect URI to
# {BACKEND_ORIGIN}/auth/gitlab/callback, and scope to "api".
GITLAB_OAUTH_CLIENT_ID=""
GITLAB_OAUTH_CLIENT_SECRET=""

# "Login with Google" — create an OAuth client in Google Cloud Console.
# Set the Authorized redirect URI to {BACKEND_ORIGIN}/auth/google/callback
# and use scope "openid profile email".
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Optional — only needed for self-hosted GitLab instances (the root site
# URL, not the /api/v4 path — that's GITLAB_BASE_URL above).
# GITLAB_INSTANCE_URL="https://gitlab.example.com"

# Optional — organization/team invite emails. Without these set, invites
# still work: EmailService logs the invite link instead of sending it, and
# the Team page always shows a "copy invite link" fallback regardless.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# Hostname sent in the SMTP greeting (EHLO). Defaults to SMTP_USER's domain;
# only set it if that's not a real domain. Google's relay rejects the
# "[127.0.0.1]" a container would otherwise send.
# SMTP_EHLO_NAME="yourdomain.com"
# Single quotes — dotenv keeps \" escapes literally and Gmail rejects the address.
# SMTP_FROM='"audit/bench" <no-reply@yourdomain.com>'
# Mailbox that receives /contact form messages (Reply-To is the visitor).
# Defaults to SMTP_USER.
# CONTACT_INBOX="contact@yourdomain.com"
# Mailbox told about every new sign-up and paid plan request (so someone can
# check the Wise payment before approving). Defaults to hello@auditbenchai.com.
# ADMIN_NOTIFY_INBOX="team@yourdomain.com"
# Set to "false" to stop the per-signup email (the admin bell still shows them).
# SIGNUP_NOTIFY_EMAILS="false"
# Admin activity log (sign-ins, sign-ups, plan events with IP + location) is
# pruned after this many days. Default 180.
# ACTIVITY_RETENTION_DAYS="180"
# Read region/city from edge headers (Cloudflare cf-*, Vercel x-vercel-ip-*,
# App Engine x-appengine-*). Only enable when such an edge sits in front of
# the API — otherwise clients can forge them. Country always comes from the IP.
# TRUST_GEO_HEADERS="true"
# Weekly "upgrade to Pro" email to Free users (Mondays 10:00 UTC) — see
# src/email/upgrade-email.service.ts. Off unless set to "true".
# UPGRADE_EMAILS_ENABLED="false"
# Daily (11:00 UTC) "we haven't seen you in a while" email to users with no
# sign-in, audit or scan for 7 days — once per inactive stretch. See
# src/email/inactivity-email.service.ts. Off unless set to "true".
# INACTIVITY_EMAILS_ENABLED="false"

# Behind Cloud Run / a load balancer: read the visitor's real IP from
# X-Forwarded-For, so per-IP rate limits (signup: 5 an hour) apply per
# visitor instead of to everyone at once. "1" for Cloud Run directly; add one
# per extra proxy in front (e.g. "2" behind an external load balancer).
# Leave unset when the API is reached directly.
TRUST_PROXY="1"
